+  consoleOut(`# STATE_DIR=${stateDir}`);
+}
+
+// eslint-disable-next-line @typescript-eslint/no-floating-promises
+void main().then(
+  () => {
+    process.exit(0);
+  },
+  (err) => {
+    consoleOut(`# HARNESS_ERROR ${String(err)}`);
+    process.exit(1);
+  },
