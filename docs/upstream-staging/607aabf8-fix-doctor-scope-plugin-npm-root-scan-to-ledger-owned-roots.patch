+      JSON.stringify({
+        pid: deadOwnerPid,
+        createdAt: new Date().toISOString(),
+        configPath: fixture.env.OPENCLAW_CONFIG_PATH,
+        role: "sqlite-maintenance",
+        startTime: 111,
+      }),
+      "utf8",
+    );
+    const run = vi.fn(async () => "maintained");
+
+    const result = await withDoctorSqliteMaintenanceLock(
