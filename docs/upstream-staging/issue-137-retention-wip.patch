+/**
+ * Post-archive page reclamation for one archival pass. Databases running
+ * auto_vacuum=INCREMENTAL (the schema default and doctor's import retrofit)
+ * only need an incremental vacuum, which runs as an ordinary write. Legacy
+ * databases that never went through the compact retrofit keep their freelist
+ * until a full VACUUM, so this retries the same retrofit as the doctor compact
+ * path (`auto_vacuum=INCREMENTAL` then `VACUUM`) best-effort; a busy/locked
+ * file (another process still serving the store) skips cleanly and the next
+ * pass retries. The caller holds the store writer queue, so in-process writers
+ * cannot interleave.
+ */
+function reclaimSqliteFreePagesAfterArchivePass(database: OpenClawAgentDatabase): void {
+  database.walMaintenance.checkpoint();
+  const freeRow = database.db.prepare("PRAGMA freelist_count").get() as
+    | { freelist_count?: unknown }
+    | undefined;
+  const freePages = Number(freeRow?.freelist_count ?? 0);
+  if (!Number.isSafeInteger(freePages) || freePages <= 0) {
+    database.walMaintenance.checkpoint();
+    return;
+  }
+  const vacuumRow = database.db.prepare("PRAGMA auto_vacuum").get() as
+    | { auto_vacuum?: unknown }
+    | undefined;
+  const autoVacuum = Number(vacuumRow?.auto_vacuum ?? 0);
+  if (autoVacuum !== 2) {
+    // Retrofitting requires a rewrite; doing it inside the serialized pass is
+    // the only window that guarantees no in-process writer races the file.
+    database.db.exec("PRAGMA auto_vacuum = INCREMENTAL;");
+    database.db.exec("VACUUM;");
+  } else {
+    database.db.exec(`PRAGMA incremental_vacuum(${freePages});`);
+  }
+  database.walMaintenance.checkpoint();
+}
