{
  "manifest_version": "1",
  "generated": "2026-10-18",
  "surface": "openclaw CLI commands consumed by this repo's automation",
  "scope": "scripts/ci, scripts/install, scripts/monitor, scripts/maintenance, scripts/remote, .github/workflows",
  "probe_rule": "Each entry declares one or more commands. A command is PRESENT on a candidate openclaw version when `openclaw <verbs> --help` (fallback `openclaw <verbs> help`) exits 0 with non-empty output. A family (the entry's primary set, or one of its `alternatives`) is WORKING when EVERY command in it is present. An entry PASSES when ANY one of its families is WORKING. Only the entry's matched family is reported-so maintainers see exactly which command family their scripts must target.",
  "excluded": [],
  "entries": [

    {
      "id": "doctor",
      "family": "doctor",
      "consumed_by": [
        "scripts/ci/snapshot-openclaw-state.sh",
        "scripts/ci/post-deploy-sqlite-integrity-gate.sh",
        "scripts/ci/prod-rehearsal-validate.sh",
        ".github/workflows/deploy.yml"
      ],
      "note": "Durable-canary surface: the canonical migration/repair owner. --fix is the exit-code contract; compact/inspect emit --json receipts.",
      "commands": [
        { "template": "openclaw doctor --fix [--force] [--non-interactive]", "verbs": ["doctor", "--fix"] },
        { "template": "openclaw doctor --session-sqlite inspect [--session-sqlite-all-agents]", "verbs": ["doctor", "--session-sqlite", "inspect"] },
        { "template": "openclaw doctor --session-sqlite compact [--session-sqlite-all-agents] [--session-sqlite-agent <id>] [--json]", "verbs": ["doctor", "--session-sqlite", "compact"] },
        { "template": "openclaw doctor --state-sqlite compact [--json]", "verbs": ["doctor", "--state-sqlite", "compact"] }
      ],
      "parses": "--session-sqlite/--state-sqlite compact --json: {ok, results}; doctor --fix: exit-code only (must be monotonic on a healthy host)."
    },

    {
      "id": "backup-sqlite",
      "family": "backup-sqlite",
      "version_adaptive": true,
      "consumed_by": [
        "scripts/ci/snapshot-openclaw-state.sh",
        "scripts/ci/restore-shared-state-db.sh",
        ".github/workflows/deploy.yml (sqlite backup {create,list,verify} steps)"
      ],
      "note": "THE incident surface: openclaw 2026.10.4 removed the `backup sqlite` subcommand family. The gate is a real by-test-deploy failure of `backup sqlite` riding on a pin bump. Scripts that keyed on this family must migrate to the flat `backup` family below.",
      "commands": [
        { "template": "openclaw backup sqlite create --global --repository <repo> [--json]", "verbs": ["backup", "sqlite", "create"] },
        { "template": "openclaw backup sqlite list --repository <repo> [--json]", "verbs": ["backup", "sqlite", "list"] },
        { "template": "openclaw backup sqlite verify <snapshot> [--json] [--scratch <dir>]", "verbs": ["backup", "sqlite", "verify"] }
      ],
      "parses": "--json receipts with ok=true and snapshotPath/manifest; verify MUST take a positional snapshot dir and --scratch (never --repository).",
      "alternatives": [
        {
          "family": "backup",
          "note": "Flat replacement family for 2026.10.4+ (backup create/list/verify). If only THIS family is present, gate passes and reports matched_family=backup so maintainers see the migration target.",
          "commands": [
            { "template": "openclaw backup create --repository <repo> [--json]", "verbs": ["backup", "create"] },
            { "template": "openclaw backup list [--json]", "verbs": ["backup", "list"] },
            { "template": "openclaw backup verify <snapshot> [--json]", "verbs": ["backup", "verify"] }
          ]
        }
      ]
    },

